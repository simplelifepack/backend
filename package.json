{
  "name": "be",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/prisma-command.mjs generate && tsc",
    "lint": "eslint .",
    "openapi:check": "tsx src/docs/openapi.check.ts",
    "start": "node dist/index.js",
    "test:documents:security": "tsx src/routes/documents.security.test.ts",
    "test:document-hybrid": "tsx src/services/documentHybridEncryption.test.ts && tsx src/services/documentSecurityValidation.test.ts",
    "test:document-analysis": "tsx src/routes/documents.analysis.test.ts",
    "test:readiness-metadata": "tsx src/services/readiness/metadataMatcher.test.ts",
    "test:package-search": "tsx --test src/services/readiness/readinessScoring.test.ts",
    "test:package-bundle": "node --import tsx --test src/ai/packageRefreshBundling.test.ts",
    "test:ownership-default-packs": "tsx -r dotenv/config src/services/identity/ownershipAndDefaultPacks.test.ts",
    "test:ownership-unit": "tsx src/services/identity/ownershipDetection.unit.test.ts",
    "test:source-authority": "tsx src/ai/sourceAuthority.test.ts",
    "test:ai-schema": "tsx src/ai/providers/openai.test.ts",
    "test:google-auth": "tsx src/services/googleAuth.test.ts",
    "test:auth-email": "tsx -r dotenv/config src/services/authEmail.test.ts",
    "test:auth-cookie": "tsx src/auth/refreshCookie.test.ts",
    "test:auth-session": "tsx src/services/authSession.test.ts",
    "test:email-branding": "node --import tsx src/services/email/templates/emailBranding.test.ts",
    "test:email-config": "tsx src/config/email.test.ts",
    "test:gmail": "tsx src/services/gmail/gmail.test.ts",
    "test:drive": "tsx src/services/drive/drive.test.ts",
    "test:storage": "tsx src/infrastructure/storage/storage.test.ts",
    "keys:rewrap": "tsx src/scripts/rewrapDocumentKeys.ts",
    "documents:audit-storage": "tsx src/scripts/auditDocumentStorage.ts",
    "documents:migrate-trust-state": "tsx src/scripts/migrateDocumentTrustState.ts",
    "packages:backfill-sources": "tsx -r dotenv/config src/scripts/backfillPackageSources.ts",
    "packages:import-defaults": "node --import tsx --require dotenv/config src/scripts/importDefaultPackagesFromEvents.ts",
    "packages:provision-admin": "tsx -r dotenv/config src/scripts/provisionPackagesAdmin.ts",
    "email:verify-smtp": "tsx src/scripts/verifySmtp.ts",
    "email:send-test": "tsx src/scripts/sendAuthTestEmail.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "vercel-build": "node --import tsx src/scripts/runVercelBuild.ts",
    "postinstall": "node scripts/prisma-command.mjs generate",
    "test:package-proxy": "node --import tsx --test src/ai/packageProxy.test.ts",
    "test:usage:integration": "node --import tsx src/services/accountUsage.integration.test.ts && node --import tsx src/routes/usage.http.integration.test.ts && node --import tsx src/routes/packageQuota.http.integration.test.ts",
    "test:privacy": "node --import tsx --test src/privacy/privacy.test.ts src/middleware/errorHandling.test.ts",
    "test:privacy:integration": "node --import tsx src/privacy/privacy.integration.test.ts && node --import tsx src/privacy/health.integration.test.ts && node --import tsx src/privacy/modules.integration.test.ts && node --import tsx src/privacy/documents.integration.test.ts && node --import tsx src/privacy/auth.integration.test.ts && node --import tsx src/privacy/trust.integration.test.ts && node --import tsx src/privacy/catalogue.integration.test.ts",
    "privacy:migrate-jobs-exports": "node --import tsx src/scripts/migratePrivateJobsAndExports.ts",
    "privacy:migrate-records": "node --import tsx src/scripts/migratePrivateRecords.ts",
    "dev:local-private": "node --import tsx src/scripts/runLocalBackend.ts",
    "test:document-ai": "node --import tsx --test src/services/documentAnalyzer/openaiDocumentAnalyzer.test.ts src/services/documentImportAnalysis.test.ts src/services/healthExtraction.service.test.ts src/services/pdfOperations.test.ts",
    "privacy:verify-local": "node --import tsx src/scripts/verifyLocalPrivateWrites.ts",
    "privacy:migrate-vercel": "node --import tsx src/scripts/runVercelPrivateMigration.ts",
    "test:privacy-vercel": "node --import tsx --test src/privacy/vercelMigration.test.ts",
    "billing:setup-test-plans": "node --import tsx src/scripts/setupRazorpayPlans.ts",
    "billing:reconcile": "node --import tsx src/scripts/reconcileBilling.ts",
    "test:billing": "node --import tsx --test src/services/billing/*.test.ts",
    "test:digilocker": "node --import tsx src/services/digilocker/digilocker.test.ts && node --import tsx --test src/services/digilocker/returnTarget.test.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@prisma/client": "^6.10.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/web-push": "^3.6.4",
    "@vercel/functions": "3.6.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.9.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "htmlparser2": "10.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "10.2.1",
    "openai": "^6.45.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.2",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vercel/nft": "1.10.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prisma": "^6.10.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
