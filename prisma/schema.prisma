generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountTier {
  free
  paid
}

model UserAIUsage {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  period String
  actionCount Int @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, period])
  @@map("user_ai_usage")
}

model User {
  private_name String?
  private_email String?
  private_country String?
  private_passportCountry String?
  private_homeCurrency String?
  private_appearance String?
  private_aiProcessingEnabled String?
  accountTier AccountTier @default(free)
  aiUsage UserAIUsage[]
  storageCleanup StorageCleanup[]
  id                         String                      @id @default(cuid())
  name                       String
  email                      String                      @unique
  authVersion                Int                         @default(0)
  passwordHash               String?
  pinHash                    String?
  pinAttemptCount            Int                         @default(0)
  pinLockedUntil             DateTime?
  country                    String?
  passportCountry            String?
  homeCurrency               String?
  appearance                 String                     @default("dark")
  aiProcessingEnabled        Boolean                    @default(true)
  deletionRequestedAt        DateTime?
  scheduledDeletionAt        DateTime?
  welcomeEmailSentAt         DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  accountChangeOtps          AccountChangeOtp[]
  identityProfile            UserIdentityProfile?
  externalIdentities         ExternalIdentity[]
  externalConnections        ExternalConnection[]
  externalDocumentCandidates ExternalDocumentCandidate[]
  externalOAuthStates        ExternalOAuthState[]
  digiLockerConsentSessions  DigiLockerConsentSession[]
  ownedTrustMembers          TrustMember[]               @relation("TrustMemberOwner")
  linkedTrustMemberships     TrustMember[]               @relation("TrustMemberLinkedUser")
  wealthRecords              WealthRecord[]
  healthMembers              HealthMember[]
  healthDocuments            HealthDocument[]
  healthMeasurements         HealthMeasurement[]
  trackedHealthMetrics       TrackedHealthMetric[]
  healthMedications          HealthMedication[]
  healthFollowUps            HealthFollowUp[]
  healthReminders            HealthReminder[]
  pushSubscriptions          PushSubscription[]
  exportJobs                 AccountExportJob[]
  requirementAssignments     RequirementAssignment[]
  customPackageGenerationJobs CustomPackageGenerationJob[]

  @@index([scheduledDeletionAt])
}

model CustomPackageGenerationJob {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dedupeKey          String
  packageType        String
  documentLabels     String[]
  status             String    @default("queued")
  statusMessage      String?
  draft              Json?
  errorCode          String?
  errorMessage       String?
  retryCount         Int       @default(0)
  provider429Count   Int       @default(0)
  hasVerifiedOfficialSource Boolean @default(false)
  confidence         String?
  disclaimer         String?
  queuedAt           DateTime  @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  leaseExpiresAt     DateTime?
  lockedBy           String?
  processingMs       Int?
  aiMs               Int?
  saveMs             Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, dedupeKey, status])
  @@index([status, queuedAt])
  @@index([leaseExpiresAt])
}

model PushSubscription {
  private_endpoint String?
  private_p256dh String?
  private_auth String?
  private_userAgent String?
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?
  active    Boolean   @default(true)
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, active])
  @@map("push_subscriptions")
}

model TrustMember {
  private_email String?
  private_name String?
  private_relation String?
  private_customRelation String?
  private_dateOfBirth String?
  private_bloodGroup String?
  id              String                  @id @default(cuid())
  ownerUserId     String
  owner           User                    @relation("TrustMemberOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  memberUserId    String?
  memberUser      User?                   @relation("TrustMemberLinkedUser", fields: [memberUserId], references: [id], onDelete: SetNull)
  email           String
  name            String
  relation        TrustRelation
  customRelation  String?
  dateOfBirth     String
  bloodGroup      String
  accessType      TrustMemberAccessType
  status          TrustMemberStatus       @default(INVITED)
  invitedAt       DateTime                @default(now())
  inviteTokenHash String?                 @unique
  inviteExpiresAt DateTime?
  invitePinHash   String?
  rejectedAt      DateTime?
  pinAttemptCount Int                     @default(0)
  pinLockedUntil  DateTime?
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  permissions     TrustMemberPermission[]

  @@index([ownerUserId, status])
  @@index([memberUserId, status])
  @@index([email, status])
  @@index([inviteExpiresAt])
  @@map("trust_members")
}

model TrustMemberPermission {
  id            String                @id @default(cuid())
  trustMemberId String
  trustMember   TrustMember           @relation(fields: [trustMemberId], references: [id], onDelete: Cascade)
  module        TrustPermissionModule
  canView       Boolean               @default(false)
  canDownload   Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([trustMemberId, module])
  @@index([trustMemberId])
  @@map("trust_member_permissions")
}

enum TrustMemberAccessType {
  VIEW_ONLY
  FAMILY_MEMBER
  EMERGENCY_ACCESS
}

enum TrustMemberStatus {
  INVITED
  ACTIVE
  REVOKED
  REJECTED
}

enum TrustRelation {
  SPOUSE
  PARENT
  CHILD
  SIBLING
  GUARDIAN
  RELATIVE
  FRIEND
  OTHER
}

enum TrustPermissionModule {
  DOCUMENTS
  HEALTH
  WEALTH
}

model ExternalIdentity {
  private_providerAccountId String?
  private_avatarUrl String?
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  avatarUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model UserIdentityProfile {
  private_fullName String?
  private_normalizedNameHash String?
  private_dateOfBirth String?
  private_dateOfBirthHash String?
  private_documentNumber String?
  private_verified String?
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String
  normalizedNameHash    String
  dateOfBirth           String
  dateOfBirthHash       String
  documentNumber        String
  createdFromDocumentId String
  verified              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model RefreshToken {
  authVersion Int @default(0)
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  attemptCount Int    @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SignupVerification {
  private_email String?
  private_name String?
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  otpHash      String
  expiresAt    DateTime
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
  @@map("signup_verifications")
}

model AccountChangeOtp {
  private_newEmail String?
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose         String
  newEmail        String?
  newPasswordHash String?
  newPinHash      String?
  otpHash         String
  expiresAt       DateTime
  attemptCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, purpose])
  @@index([expiresAt])
  @@map("account_change_otps")
}

model Document {
  private_title String?
  private_displayName String?
  private_uniqueIdentifier String?
  private_uniqueIdentifierHash String?
  private_extractedKeyFields String?
  private_rawText String?
  private_originalName String?
  private_storedName String?
  private_path String?
  private_storageKey String?
  private_wrappedKey String?
  private_originalSha256 String?
  private_documentType String?
  private_normalizedType String?
  private_documentTypeCode String?
  private_category String?
  private_confidence String?
  private_classificationConfidence String?
  private_classificationSignals String?
  private_ownershipStatus String?
  private_ownershipConfidence String?
  private_ownershipMatchedFields String?
  private_ownershipMismatchedFields String?
  private_readinessEligible String?
  private_fields String?
  private_contentHash String?
  private_sourceMessageId String?
  private_sourceAttachmentId String?
  private_driveFileId String?
  private_sourceModifiedTime String?
  private_sourceChecksum String?
  storageUsageKey String?
  id                        String                   @id @default(cuid())
  title                     String?
  displayName               String?
  ownerProfileId            String?
  targetProfileId           String?
  uniqueIdentifier          String?
  uniqueIdentifierHash      String?
  extractedKeyFields        Json?
  rawText                   String?
  originalName              String
  storedName                String
  mimeType                  String
  size                      Int
  path                      String
  storageKey                String?
  storageBucket             String?
  storageMimeType           String?
  encryptionVersion         Int?
  contentAlgorithm          String?
  keyAlgorithm              String?
  keyId                     String?
  keyVersion                Int?
  encryptionIv              String?
  wrappedKey                String?
  originalSha256            String?
  encryptedSha256           String?
  encryptedSize             Int?
  ciphertextHash            String?
  userScopedDedupHash       String?
  metadataIntegrityHash     String?
  integrityStatus           String                   @default("pending")
  scanStatus                String?
  scanCompletedAt           DateTime?
  documentType              String
  normalizedType            String?
  documentTypeCode          String?
  category                  String
  analysisSource            String
  confidence                Float
  classificationStatus      String                   @default("pending")
  classificationConfidence  Float                    @default(0)
  classificationSignals     Json?
  ownershipStatus           String                   @default("unknown")
  ownershipConfidence       Float                    @default(0)
  ownershipMatchedFields    String[]                 @default([])
  ownershipMismatchedFields String[]                 @default([])
  readinessEligible         Boolean                  @default(false)
  fields                    Json
  contentHash               String?
  sourceProvider            String?
  sourceMessageId           String?
  sourceAttachmentId        String?
  driveFileId               String?
  sourceModifiedTime        DateTime?
  sourceChecksum            String?
  lastAnalyzed              DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  deletedAt                 DateTime?
  wealthAttachments         WealthRecordAttachment[]
  files                     DocumentFile[]
  healthDocuments           HealthDocument[]
  requirementAssignments    RequirementAssignment[]

  @@unique([id, ownerProfileId])
  @@unique([ownerProfileId, contentHash])
  @@unique([ownerProfileId, driveFileId])
  @@index([normalizedType])
  @@index([documentTypeCode])
  @@index([ownerProfileId, readinessEligible])
  @@index([targetProfileId, readinessEligible])
  @@index([classificationStatus, ownershipStatus, integrityStatus])
  @@index([userScopedDedupHash])
  @@index([documentType])
  @@index([ownerProfileId])
  @@index([storageKey])
  @@index([keyId, keyVersion])
  @@index([uniqueIdentifier])
  @@index([uniqueIdentifierHash])
  @@index([sourceProvider, sourceMessageId])
  @@index([ownerProfileId, sourceChecksum])
}

model HealthMember {
  private_name String?
  private_relation String?
  private_bloodGroup String?
  private_dateOfBirth String?
  private_conditions String?
  private_allergies String?
  private_emergencyContactName String?
  private_emergencyContactPhone String?
  private_primaryDoctor String?
  private_insuranceProvider String?
  private_insurancePolicyNumber String?
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relation     String
  bloodGroup   String?
  dateOfBirth  DateTime?
  conditions   String?
  allergies    String?
  emergencyContactName  String?
  emergencyContactPhone String?
  primaryDoctor         String?
  insuranceProvider     String?
  insurancePolicyNumber String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  documents    HealthDocument[]
  measurements HealthMeasurement[]
  tracked      TrackedHealthMetric[]
  medications  HealthMedication[]
  followUps    HealthFollowUp[]
  reminders    HealthReminder[]

  @@index([userId])
  @@map("health_members")
}

model HealthDocument {
  private_processingStatus String?
  private_type String?
  private_documentDate String?
  private_provider String?
  private_doctor String?
  private_processingError String?
  private_patientName String?
  private_patientDateOfBirth String?
  private_pendingExtraction String?
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId         String?
  member           HealthMember?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  documentId       String
  document         Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type             String
  documentDate     DateTime?
  provider         String?
  doctor           String?
  processingStatus String              @default("pending")
  processingError  String?
  patientName      String?
  patientDateOfBirth DateTime?
  pendingExtraction Json?
  createdAt        DateTime            @default(now())
  processedAt      DateTime?
  measurements     HealthMeasurement[]
  medications      HealthMedication[]
  followUps        HealthFollowUp[]
  reminders        HealthReminder[]

  @@unique([userId, documentId])
  @@index([userId, memberId, documentDate])
  @@index([documentId])
  @@map("health_documents")
}

model HealthMeasurement {
  private_metricKey String?
  private_displayName String?
  private_originalName String?
  private_value String?
  private_secondaryValue String?
  private_unit String?
  private_context String?
  private_bodySite String?
  private_referenceMin String?
  private_referenceMax String?
  private_referenceText String?
  private_measuredAt String?
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId         String
  member           HealthMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sourceDocumentId String?
  sourceDocument   HealthDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  metricKey        String
  displayName      String
  originalName     String
  value            Float
  secondaryValue   Float?
  unit             String
  context          String?
  bodySite         String?
  referenceMin     Float?
  referenceMax     Float?
  referenceText    String?
  measuredAt       DateTime
  createdAt        DateTime       @default(now())

  @@index([userId, memberId, metricKey, measuredAt])
  @@index([sourceDocumentId])
  @@map("health_measurements")
}

model TrackedHealthMetric {
  private_metricKey String?
  private_displayName String?
  private_context String?
  private_bodySite String?
  private_enabled String?
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId    String
  member      HealthMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  metricKey   String
  displayName String
  context     String?
  bodySite    String?
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, memberId, metricKey, context, bodySite])
  @@index([userId, memberId, enabled])
  @@map("tracked_health_metrics")
}

model HealthMedication {
  private_name String?
  private_dose String?
  private_frequency String?
  private_duration String?
  private_quantity String?
  private_whenToTake String?
  private_mealTiming String?
  private_repeatRunsOut String?
  private_status String?
  private_repeats String?
  private_runsOutAt String?
  private_stoppedAt String?
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId         String
  member           HealthMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sourceDocumentId String?
  sourceDocument   HealthDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  name             String
  dose             String?
  frequency        String?
  duration         String?
  quantity         String?
  whenToTake       String[]       @default([])
  mealTiming       String?
  repeatRunsOut    DateTime?
  status           String         @default("continuing")
  repeats          Boolean        @default(false)
  runsOutAt        DateTime?
  stoppedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId, memberId])
  @@index([userId, memberId, status])
  @@index([sourceDocumentId])
  @@map("health_medications")
}

model HealthFollowUp {
  private_title String?
  private_explicitDate String?
  private_recommendedAfterValue String?
  private_recommendedAfterUnit String?
  private_dueDate String?
  private_sourceText String?
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId              String
  member                HealthMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sourceDocumentId      String
  sourceDocument        HealthDocument   @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  title                 String
  explicitDate          DateTime?
  recommendedAfterValue Int?
  recommendedAfterUnit  String?
  dueDate               DateTime?
  sourceText            String?
  createdAt             DateTime         @default(now())
  reminders             HealthReminder[]

  @@index([userId, memberId, dueDate])
  @@index([sourceDocumentId])
  @@map("health_follow_ups")
}

model HealthReminder {
  private_title String?
  private_type String?
  private_dueDate String?
  private_frequency String?
  private_recurrence String?
  private_status String?
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId         String
  member           HealthMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sourceFollowUpId String?
  sourceFollowUp   HealthFollowUp? @relation(fields: [sourceFollowUpId], references: [id], onDelete: Cascade)
  sourceDocumentId String?
  sourceDocument   HealthDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  title            String
  type             String?
  dueDate          DateTime
  frequency        String?
  origin           String
  recurrence       String?
  status           String          @default("active")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId, memberId, dueDate, status])
  @@index([sourceDocumentId])
  @@map("health_reminders")
}

model DocumentFile {
  private_originalName String?
  private_storageKey String?
  private_storedName String?
  private_wrappedKey String?
  private_originalSha256 String?
  privacyOwnerId String?
  storageUsageKey String?
  id                String   @id @default(cuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageIndex         Int
  sourceType        String   @default("upload")
  pageCount         Int?
  originalName      String
  mimeType          String
  size              Int
  storageKey        String
  storedName        String
  storageBucket     String?
  storageMimeType   String?
  encryptionVersion Int?
  contentAlgorithm  String?
  keyAlgorithm      String?
  keyId             String?
  keyVersion        Int?
  encryptionIv      String?
  wrappedKey        String?
  originalSha256    String?
  encryptedSha256   String?
  encryptedSize     Int?
  ciphertextHash    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([documentId, pageIndex])
  @@index([documentId])
  @@index([documentId, pageIndex])
}

model TemporaryUpload {
  private_originalName String?
  private_contentHash String?
  private_sourceMessageId String?
  private_sourceAttachmentId String?
  private_wrappedKey String?
  private_originalSha256 String?
  id                  String    @id @default(uuid())
  ownerProfileId      String
  storagePath         String
  originalName        String
  detectedMimeType    String
  size                Int
  status              String    @default("active")
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  consumedAt          DateTime?
  contentHash         String?
  sourceProvider      String?
  sourceMessageId     String?
  sourceAttachmentId  String?
  externalCandidateId String?
  encryptionVersion   Int?
  contentAlgorithm    String?
  keyAlgorithm        String?
  keyId               String?
  keyVersion          Int?
  encryptionIv        String?
  wrappedKey          String?
  originalSha256      String?
  encryptedSha256     String?
  encryptedSize       Int?
  scanStatus          String?
  scanCompletedAt     DateTime?

  @@index([ownerProfileId, status, expiresAt])
  @@index([expiresAt])
}

model DigiLockerConsentSession {
  private_verificationId String?
  private_referenceId String?
  private_statusMessage String?
  private_consentUrl String?
  private_redirectUrl String?
  private_requestedDocuments String?
  private_availableDocuments String?
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationId     String    @unique
  referenceId        String?
  environment        String
  status             String    @default("PENDING")
  statusMessage      String?
  consentUrl         String?
  redirectUrl        String
  requestedDocuments String[]
  availableDocuments String[]  @default([])
  expiresAt          DateTime?
  authenticatedAt    DateTime?
  cancelledAt        DateTime?
  lastCheckedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, status])
  @@index([verificationId])
  @@map("digilocker_consent_sessions")
}

model ExternalConnection {
  private_providerAccountId String?
  private_providerEmail String?
  private_encryptedRefreshToken String?
  private_grantedScopes String?
  private_scanPhase String?
  private_lastScanError String?
  id                    String                      @id @default(cuid())
  userId                String
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String
  providerAccountId     String
  providerEmail         String
  encryptedRefreshToken String
  grantedScopes         String[]
  status                String                      @default("connected")
  lastScannedAt         DateTime?
  lastSuccessfulSync    DateTime?
  scanStartedAt         DateTime?
  scanPhase             String?
  scanProcessed         Int                         @default(0)
  scanTotal             Int                         @default(0)
  indexedCount          Int                         @default(0)
  lastScanError         String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  candidates            ExternalDocumentCandidate[]

  @@unique([userId, provider])
  @@index([userId, status])
}

model ExternalOAuthState {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  stateHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, provider, expiresAt])
}

model ExternalDocumentCandidate {
  private_sourceKey String?
  private_externalMessageId String?
  private_externalAttachmentId String?
  private_filename String?
  private_sender String?
  private_subject String?
  private_receivedAt String?
  private_suggestedCategory String?
  private_suggestedDocumentType String?
  private_relevanceReason String?
  private_relevanceScore String?
  private_legitimacyReason String?
  private_legitimacyScore String?
  private_reviewRequired String?
  private_matchedSignals String?
  private_rejectedSignals String?
  private_ignoredReason String?
  private_externalPartId String?
  id                    String             @id @default(cuid())
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId          String
  connection            ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider              String
  sourceKey             String
  externalMessageId     String
  externalAttachmentId  String?
  filename              String
  mimeType              String
  size                  Int
  sender                String
  subject               String
  receivedAt            DateTime
  suggestedCategory     String
  suggestedDocumentType String
  relevanceReason       String
  relevanceScore        Int
  legitimacyReason      String             @default("Needs review")
  legitimacyScore       Int                @default(0)
  reviewRequired        Boolean            @default(false)
  matchedSignals        String[]           @default([])
  rejectedSignals       String[]           @default([])
  ignoredReason         String?
  externalPartId        String?
  status                String             @default("candidate")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([connectionId, sourceKey])
  @@index([userId, status, receivedAt])
}

model ReadinessPack {
  legacyPrivateMetadata String?
  cataloguePrivacyVersion Int? @default(2)
  private_slug String?
  private_title String?
  private_subtitle String?
  private_category String?
  private_aliases String?
  private_description String?
  private_keywords String?
  private_searchMetadata String?
  private_sourceType String?
  private_sourceName String?
  private_sourceTitle String?
  private_sourceUrl String?
  private_lastCheckedAt String?
  private_verificationSources String?
  private_lastVerifiedAt String?
  private_verificationStatus String?
  id                  String        @id @default(cuid())
  slug                String        @unique
  title               String
  subtitle            String?
  category            String
  aliases             String[]
  description         String
  keywords            String[]
  searchMetadata      Json?
  sourceType          String        @default("curated")
  sourceName          String?
  sourceTitle         String?
  sourceUrl           String?
  lastCheckedAt       DateTime?
  verificationSources Json?
  lastVerifiedAt      DateTime?
  verificationStatus  String        @default("needs_review")
  createdBy           String        @default("seed")
  version             Int           @default(1)
  requirements        Requirement[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  @@index([category])
  @@unique([id, createdBy])
  @@index([createdBy])
  @@index([deletedAt])
}

model Requirement {
  private_title String?
  private_documentType String?
  private_owner String?
  private_metadata String?
  private_description String?
  private_required String?
  private_group String?
  private_acceptedDocumentTypes String?
  private_alternativeLabels String?
  privacyOwnerId String?
  id                    String        @id @default(cuid())
  packId                String
  pack                  ReadinessPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  title                 String
  documentType          String        @default("unknown")
  owner                 String        @default("self")
  metadata              Json?
  description           String
  required              Boolean       @default(true)
  group                 String
  acceptedDocumentTypes String[]
  alternativeLabels     String[]
  sortOrder             Int           @default(0)
  deletedAt             DateTime?
  assignments           RequirementAssignment[]

  @@index([packId])
  @@index([documentType, owner])
  @@index([deletedAt])
}

model RequirementAssignment {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirementId    String
  requirement      Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  documentId       String
  document         Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  assignmentSource String
  overriddenAt     DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([userId, requirementId])
  @@index([documentId])
  @@index([requirementId])
  @@map("requirement_assignments")
}

model WealthRecord {
  private_type String?
  private_title String?
  private_details String?
  private_notes String?
  private_followUpDate String?
  private_followUpNote String?
  id           String                   @id @default(cuid())
  ownerUserId  String
  owner        User                     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  type         WealthRecordType
  title        String
  details      Json
  notes        String?
  followUpDate DateTime?
  followUpNote String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  attachments  WealthRecordAttachment[]

  @@index([ownerUserId, type])
  @@index([followUpDate])
  @@map("wealth_records")
}

model WealthRecordAttachment {
  id             String       @id @default(cuid())
  wealthRecordId String
  wealthRecord   WealthRecord @relation(fields: [wealthRecordId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([wealthRecordId, documentId])
  @@index([documentId])
  @@map("wealth_record_attachments")
}

model ReadinessFormCategory {
  id               String                @id @default(cuid())
  module           String
  code             String
  label            String
  description      String?
  sortOrder        Int                   @default(0)
  isActive         Boolean               @default(true)
  wealthRecordType WealthRecordType?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  subtypes         ReadinessFormSubtype[]

  @@unique([module, code])
  @@index([module, isActive, sortOrder])
  @@map("readiness_form_categories")
}

model ReadinessFormSubtype {
  id          String               @id @default(cuid())
  categoryId  String
  category    ReadinessFormCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  code        String
  label       String
  description String?
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  fields      ReadinessFormField[]

  @@unique([categoryId, code])
  @@index([categoryId, isActive, sortOrder])
  @@map("readiness_form_subtypes")
}

model ReadinessFormField {
  id           String              @id @default(cuid())
  subtypeId    String
  subtype      ReadinessFormSubtype @relation(fields: [subtypeId], references: [id], onDelete: Cascade)
  fieldId      String
  label        String
  inputType    String
  required     Boolean             @default(false)
  placeholder  String?
  defaultValue Json?
  options      Json?
  validation   Json?
  group        String?
  visibility   Json?
  sortOrder    Int                 @default(0)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([subtypeId, fieldId])
  @@index([subtypeId, isActive, sortOrder])
  @@map("readiness_form_fields")
}

enum WealthRecordType {
  ASSET
  LOAN_TAKEN
  LOAN_GIVEN
  INSURANCE
  PAYMENT_PROOF
}

model StorageCleanup {
  encryptedKey String?
  storageKey String @id
  ownerUserId String
  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  sizeBytes BigInt
  createdAt DateTime @default(now())
  @@index([ownerUserId])
  @@map("storage_cleanup")
}

model AccountExportJob {
  private_errorMessage String?
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("REQUESTED")
  storageKey   String?
  fileName     String?
  sizeBytes    Int?
  errorMessage String?
  archiveEncryptionVersion Int?
  requestedAt  DateTime  @default(now())
  preparedAt   DateTime?
  expiresAt    DateTime?
  downloadedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, status])
  @@index([expiresAt])
  @@map("account_export_jobs")
}
