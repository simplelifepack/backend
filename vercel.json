{
  "version": 2,
  "regions": [
    "bom1"
  ],
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/swagger-ui-dist/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/integrations/digilocker/worker",
      "schedule": "0 0 * * *"
    }
  ]
}
