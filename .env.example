PORT=4000
APP_ENV=development
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
# Additional native mobile server OAuth audience; retain the website client above.
GOOGLE_MOBILE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Future integration (routes disabled): GOOGLE_GMAIL_REDIRECT_URI=http://localhost:4000/api/integrations/gmail/callback
# Future integration (routes disabled): GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/api/integrations/drive/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Compatibility: the existing local database name is retained to preserve its volume.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/lifepack?schema=public"
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
OPENAI_API_KEY=
# Separate models by workload. Requirements needs web search and stronger sourcing;
# Document AI reads original PDFs and every image page for text and structured analysis.
OPENAI_REQUIREMENTS_MODEL=gpt-5.4-mini
OPENAI_REQUIREMENTS_REASONING_EFFORT=none
OPENAI_ICR_MODEL=gpt-5-mini
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@readiness.com
DOCUMENT_ENCRYPTION_KEY=base64:replace-with-32-random-bytes
DOCUMENT_METADATA_ENCRYPTION_KEY=base64:replace-with-a-different-32-byte-key
DOCUMENT_LOOKUP_HMAC_KEY=base64:replace-with-a-different-32-byte-key
DOCUMENT_DEDUP_HMAC_KEY=base64:replace-with-a-different-32-byte-key
DOCUMENT_RSA_ACTIVE_KEY_ID=readiness-primary
DOCUMENT_RSA_ACTIVE_KEY_VERSION=1
DOCUMENT_RSA_PUBLIC_KEY=base64:replace-with-base64-spki-public-pem
DOCUMENT_RSA_PRIVATE_KEY=base64:replace-with-base64-pkcs8-private-pem
# Optional JSON array containing the active and retained rotation keys. Treat it as a backend secret.
DOCUMENT_RSA_KEYRING_JSON=
DOCUMENT_MALWARE_SCANNER_COMMAND=
DOCUMENT_MALWARE_SCANNER_ARGS=["--no-summary","{file}"]
MAX_DOCUMENT_IMAGE_WIDTH=12000
MAX_DOCUMENT_IMAGE_HEIGHT=12000
MAX_DOCUMENT_IMAGE_PIXELS=60000000
MAX_DOCUMENT_PDF_PAGES=500
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/auth
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
JSON_BODY_LIMIT=1mb
# Swagger/OpenAPI docs are enabled outside production. Set to true only when
# you intentionally want /api-docs and /openapi.json exposed in production.
API_DOCS_ENABLED=false
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
REFRESH_RATE_LIMIT_WINDOW_MINUTES=15
REFRESH_RATE_LIMIT_MAX=60
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=60
UPLOAD_RATE_LIMIT_MAX=30
ADMIN_RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_RATE_LIMIT_MAX=10
# Protects operational endpoints such as package seeding and admin notification sends.
ADMIN_SEED_TOKEN=
# Required only when running npm run packages:provision-admin. Do not commit a real value.
PACKAGES_ADMIN_INITIAL_PASSWORD=
TRUST_PROXY=

# Required for SMTP-delivered auth emails. Use your deployed HTTPS frontend URL in production.
APP_URL=https://your-readiness-web-app.example.com
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Readines <support@readines.info>"

# Required for all private v2 database content and account export archives. Provision in
# a secret manager. Each value is base64: followed by 32 random bytes in base64.
# JSON maps key IDs to encryption keys. Keep old keys during encryption rotation.
PRIVATE_DATA_ACTIVE_KEY_ID=
PRIVATE_DATA_KEYRING_JSON=
# Independent stable HMAC key; must differ from every encryption key.
PRIVATE_DATA_LOOKUP_KEY=

# Early access: generate a dedicated random secret of at least 32 characters.
# Keep stable: rotating this invalidates outstanding unsubscribe links.
WAITLIST_SECRET=
WAITLIST_PUBLIC_URL=https://readines.com
# Exact extra origins only; do not use wildcard Vercel origins.
# readines.com, www.readines.com, frontend-web-nine-amber.vercel.app and
# http://localhost:5173 are built in. Existing CORS_ORIGINS remains supported.
CORS_LOCALHOST_ORIGINS=
CORS_PREVIEW_ORIGINS=

# Razorpay subscriptions. Never expose KEY_SECRET or WEBHOOK_SECRET to the browser.
# Start with rzp_test_* credentials and separate Test-mode Plans/webhook endpoint.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_ANNUAL_PLAN_ID=

# Optional hosted test-payment preview; does not activate subscriptions.
RAZORPAY_TEST_PAYMENT_BUTTON_ID=

# Direct DigiLocker / API Setu requester credentials (backend only).
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:4000/api/integrations/digilocker/callback
# Only the verified direct-provider production contract is enabled.
DIGILOCKER_ENVIRONMENT=production
